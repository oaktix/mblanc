generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  phone            String?
  emailVerified    DateTime?
  image            String?
  password         String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  role             Role      @default(CUSTOMER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  couponUsages     CouponUsage[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    String
  description String
  basePrice   Float
  sku         String      @unique
  stock       Int         @default(0)
  status      String      @default("DRAFT")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  images      String[]
  orderItems  OrderItem[]
  variations  Variation[]
  coupons     Coupon[]
}

model Variation {
  id         String      @id @default(cuid())
  productId  String
  size       String?
  color      String?
  fabric     String?
  sku        String      @unique
  price      Float
  stock      Int         @default(0)
  images     String[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  total           Float
  discount        Float?
  couponCode      String?
  status          OrderStatus @default(PENDING)
  shippingDetails Json?
  paymentStatus   String      @default("PENDING")
  paystackRef     String?     @unique
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  productId   String
  variationId String?
  quantity    Int
  price       Float
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id])
  variation   Variation? @relation(fields: [variationId], references: [id])
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        CouponType
  value       Float
  scope       CouponScope  @default(SITEWIDE)
  minPurchase Float?
  maxPurchase Float?
  maxUsages   Int?
  usageCount  Int          @default(0)
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  products    Product[]
  usages      CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id           String   @id @default("singleton")
  siteName     String   @default("MBlanc Bespoke")
  headerLogo   String?
  footerLogo   String?
  contactEmail String   @default("hello@mblancfits.com")
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum CouponScope {
  SITEWIDE
  PRODUCT
}
